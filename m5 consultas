        v.fecha_venta AS fecha,
        v.cantidad * v.precio_unitario AS total_venta,
        'Online' AS canal
    FROM ventas v
    WHERE ...

    UNION ALL

    SELECT
        v.fecha_venta AS fecha,
        v.cantidad * v.precio_unitario AS total_venta,
        'Presencial' AS canal
    FROM ventas v
